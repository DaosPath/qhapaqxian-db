CREATE AGENT archivist
  IDENTITY imperial;
ERROR:  agent "archivist" already exists in schema "public"
START SESSION FOR AGENT archivist
  WITH CONTEXT jsonb_build_object('mission', 'index');
SELECT qxsessionagentid = (SELECT oid FROM pg_qx_agent WHERE qxagentname = 'archivist') AS linked_agent,
       qxsessionnamespacepolicyid = (SELECT qxnamespacepolicyid FROM pg_qx_agent WHERE qxagentname = 'archivist') AS linked_policy,
       qxsessionidentityid = (SELECT qxidentityid FROM pg_qx_agent WHERE qxagentname = 'archivist') AS linked_identity,
       qxsessiondbid = (SELECT oid FROM pg_database WHERE datname = current_database()) AS current_db,
       qxsessionowner = (SELECT oid FROM pg_roles WHERE rolname = current_user) AS owned_by_current_user,
       qxsessionstatus AS status,
       qxcontext IS NOT NULL AS has_context
FROM pg_qx_session
ORDER BY oid;
 linked_agent | linked_policy | linked_identity | current_db | owned_by_current_user | status | has_context 
--------------+---------------+-----------------+------------+-----------------------+--------+-------------
 t            | t             | t               | t          | t                     | a      | t
(1 row)

SELECT qxeventkind::text AS event_kind,
       qxeventlsn <> '0/0'::pg_lsn AS has_semantic_lsn,
       COALESCE(qxeventlsn > lag(qxeventlsn) OVER (ORDER BY oid), true) AS lsn_monotonic,
       qxeventtaskid = 0 AS session_scoped,
       qxeventstepid = 0 AS without_step
FROM pg_qx_event
ORDER BY oid;
   event_kind    | has_semantic_lsn | lsn_monotonic | session_scoped | without_step 
-----------------+------------------+---------------+----------------+--------------
 SESSION_STARTED | t                | t             | t              | t
(1 row)

SELECT qxtracename::text AS trace_name,
       qxtracestate AS trace_state,
       qxtracelsn <> '0/0'::pg_lsn AS has_semantic_lsn,
       COALESCE(qxtracelsn > lag(qxtracelsn) OVER (ORDER BY oid), true) AS lsn_monotonic,
       qxtracetaskid = 0 AS session_scoped
FROM pg_qx_trace
ORDER BY oid;
  trace_name  | trace_state | has_semantic_lsn | lsn_monotonic | session_scoped 
--------------+-------------+------------------+---------------+----------------
 session.root | o           | t                | t             | t
(1 row)

SELECT oid AS qx_session_oid
FROM pg_qx_session
ORDER BY oid DESC
LIMIT 1
\gset
EXPLAIN AGENT RUN TASK summarize_docs IN SESSION :qx_session_oid
  GOAL 'summarize docs'
  INPUT jsonb_build_object('topic', 'parser')
  PRIORITY high;
                                              AGENT PLAN                                              
------------------------------------------------------------------------------------------------------
 AgentPlan v1
   Command: RUN TASK
   Goal: summarize docs
   Identity: imperial
   Namespace Policy: guarded
   Task Name: summarize_docs
   Priority: high
   Checkpoint Label: stage8.after_capture
   Input Present: true
   Target State: checkpointed
   Result Mode: catalog inspection via pg_qx_*
   Checkpointable: true
   Resumable: false
   Budget Tokens: 4096
   Budget Cost: 128
   Estimated Tokens: 72
   Estimated Cost: 71
   Estimated Tool Calls: 2
   Authorized Tool Budget: tokens=16 cost=8
   Authorized Tools: search, summarize
   Steps:
     1. validate_session [cost=8, checkpoint=false, retry=false]
        check session existence, ownership, database, and active state
     2. snapshot_identity_policy [cost=11, checkpoint=false, retry=false]
        freeze agent identity and policy/budget context for the attempt
     3. authorize_tools [cost=8, checkpoint=false, retry=false]
        validate the task tool allowlist against namespace policy and registered tool catalog entries
     4. enqueue_attempt [cost=17, checkpoint=false, retry=true]
        persist the task shell and open attempt 1 in the embedded runtime
     5. capture_input [cost=13, checkpoint=false, retry=false]
        record task goal, priority, and raw input for deterministic resume
     6. durable_checkpoint [cost=14, checkpoint=true, retry=true]
        stop at a resumable checkpoint boundary before asynchronous continuation
(33 rows)

RUN TASK summarize_docs IN SESSION :qx_session_oid
  GOAL 'summarize docs'
  INPUT jsonb_build_object('topic', 'parser')
  PRIORITY high;
SELECT oid AS qx_task_oid
FROM pg_qx_task
ORDER BY oid DESC
LIMIT 1
\gset
SELECT qxtaskname::text AS task_name,
       qxtaskgoal::text AS goal,
       qxtaskpriority::text AS priority,
       qxtaskstate AS state,
       qxtasknamespacepolicyid = (SELECT qxnamespacepolicyid FROM pg_qx_agent WHERE qxagentname = 'archivist') AS linked_policy,
       qxtaskidentityid = (SELECT qxidentityid FROM pg_qx_agent WHERE qxagentname = 'archivist') AS linked_identity,
       qxtaskinput IS NOT NULL AS has_input,
       qxtaskbudgettokens AS budget_tokens,
       qxtaskbudgetcost AS budget_cost,
       qxtaskauthorizedtooltokens AS authorized_tool_tokens,
       qxtaskauthorizedtoolcost AS authorized_tool_cost,
       qxtaskestimatedtokens AS estimated_tokens,
       qxtaskestimatedcost AS estimated_cost,
       qxtaskconsumedtokens AS consumed_tokens,
       qxtaskconsumedcost AS consumed_cost,
       qxtaskauthorizedtools IS NOT NULL AS has_authorized_tools,
       qxtasksessionid = :qx_session_oid AS linked_session,
       qxtasklastattemptid <> 0 AS has_attempt,
       qxtasklastcheckpointid <> 0 AS has_checkpoint
FROM pg_qx_task
ORDER BY oid;
   task_name    |      goal      | priority | state | linked_policy | linked_identity | has_input | budget_tokens | budget_cost | authorized_tool_tokens | authorized_tool_cost | estimated_tokens | estimated_cost | consumed_tokens | consumed_cost | has_authorized_tools | linked_session | has_attempt | has_checkpoint 
----------------+----------------+----------+-------+---------------+-----------------+-----------+---------------+-------------+------------------------+----------------------+------------------+----------------+-----------------+---------------+----------------------+----------------+-------------+----------------
 summarize_docs | summarize docs | high     | k     | t             | t               | t         |          4096 |         128 |                     16 |                    8 |               72 |             71 |              60 |            52 | t                    | t              | t           | t
(1 row)

