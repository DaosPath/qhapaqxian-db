REMEMBER IN SESSION :qx_session_oid
  SCOPE semantic
  KEY 'parser.notes'
  VALUE 'stable grammar'
  TAGS ('docs', 'stage10');
REMEMBER IN SESSION :qx_session_oid
  SCOPE episodic
  KEY 'resume.status'
  VALUE 'completed'
  TAGS ('resume', 'success');
