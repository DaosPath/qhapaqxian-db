FROM pg_qx_trace
ORDER BY oid;
        trace_name        | trace_state | has_semantic_lsn | lsn_monotonic | linked_task 
--------------------------+-------------+------------------+---------------+-------------
 session.root             | o           | t                | t             | f
 runtime.queue            | c           | t                | t             | t
 runtime.dispatch         | c           | t                | t             | t
 runtime.authorize_tools  | c           | t                | t             | t
 runtime.external_submit  | c           | t                | t             | t
 runtime.capture_input    | c           | t                | t             | t
 runtime.checkpoint       | c           | t                | t             | t
 runtime.pause            | c           | t                | t             | t
 runtime.resume           | c           | t                | t             | t
 runtime.resume_dispatch  | c           | t                | t             | t
