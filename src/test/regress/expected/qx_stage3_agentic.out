-- QhapaqXian DB Stage 12 security isolation slice
CREATE AGENT archivist
  IDENTITY imperial
  MODEL 'openai:gpt-5.4'
  MEMORY PROFILE episodic
  TOOLS (search, summarize)
  POLICY guarded
  BUDGET (tokens 4096, cost 12);
SELECT qxagentname::text AS agent_name,
       qxagentnamespace = 'public'::regnamespace AS in_public_schema,
       qxagentowner = (SELECT oid FROM pg_roles WHERE rolname = current_user) AS owned_by_current_user,
       qxidentity::text AS identity_name,
       qxmodeluri::text AS model_uri,
       qxmemoryprofile::text AS memory_profile,
       qxpolicy::text AS policy_name,
       qxtools IS NOT NULL AS has_tools,
       qxbudget IS NOT NULL AS has_budget
FROM pg_qx_agent
WHERE qxagentname = 'archivist';
 agent_name | in_public_schema | owned_by_current_user | identity_name |   model_uri    | memory_profile | policy_name | has_tools | has_budget 
------------+------------------+-----------------------+---------------+----------------+----------------+-------------+-----------+------------
 archivist  | t                | t                     | imperial      | openai:gpt-5.4 | episodic       | guarded     | t         | t
(1 row)

CREATE AGENT archivist
  IDENTITY imperial;
ERROR:  agent "archivist" already exists in schema "public"
START SESSION FOR AGENT archivist
  WITH CONTEXT jsonb_build_object('mission', 'index');
SELECT qxsessionagentid = (SELECT oid FROM pg_qx_agent WHERE qxagentname = 'archivist') AS linked_agent,
       qxsessiondbid = (SELECT oid FROM pg_database WHERE datname = current_database()) AS current_db,
       qxsessionowner = (SELECT oid FROM pg_roles WHERE rolname = current_user) AS owned_by_current_user,
       qxsessionstatus AS status,
       qxcontext IS NOT NULL AS has_context
FROM pg_qx_session
ORDER BY oid;
 linked_agent | current_db | owned_by_current_user | status | has_context 
--------------+------------+-----------------------+--------+-------------
 t            | t          | t                     | a      | t
(1 row)

SELECT qxeventkind::text AS event_kind,
       qxeventlsn <> '0/0'::pg_lsn AS has_semantic_lsn,
       COALESCE(qxeventlsn > lag(qxeventlsn) OVER (ORDER BY oid), true) AS lsn_monotonic,
       qxeventtaskid = 0 AS session_scoped,
       qxeventstepid = 0 AS without_step
FROM pg_qx_event
ORDER BY oid;
   event_kind    | has_semantic_lsn | lsn_monotonic | session_scoped | without_step 
-----------------+------------------+---------------+----------------+--------------
 SESSION_STARTED | t                | t             | t              | t
(1 row)

SELECT qxtracename::text AS trace_name,
       qxtracestate AS trace_state,
       qxtracelsn <> '0/0'::pg_lsn AS has_semantic_lsn,
       COALESCE(qxtracelsn > lag(qxtracelsn) OVER (ORDER BY oid), true) AS lsn_monotonic,
       qxtracetaskid = 0 AS session_scoped
FROM pg_qx_trace
ORDER BY oid;
  trace_name  | trace_state | has_semantic_lsn | lsn_monotonic | session_scoped 
--------------+-------------+------------------+---------------+----------------
 session.root | o           | t                | t             | t
(1 row)

SELECT oid AS qx_session_oid
FROM pg_qx_session
ORDER BY oid DESC
LIMIT 1
\gset
EXPLAIN AGENT RUN TASK summarize_docs IN SESSION :qx_session_oid
  GOAL 'summarize docs'
  INPUT jsonb_build_object('topic', 'parser')
  PRIORITY high;
                                   AGENT PLAN                                    
---------------------------------------------------------------------------------
 AgentPlan v1
   Command: RUN TASK
   Goal: summarize docs
   Task Name: summarize_docs
   Priority: high
   Checkpoint Label: stage8.after_capture
   Input Present: true
   Target State: checkpointed
   Result Mode: catalog inspection via pg_qx_*
   Checkpointable: true
   Resumable: false
   Estimated Cost: 63
   Estimated Tool Calls: 0
   Steps:
     1. validate_session [cost=8, checkpoint=false, retry=false]
        check session existence, ownership, database, and active state
     2. snapshot_identity_policy [cost=11, checkpoint=false, retry=false]
        freeze agent identity and policy/budget context for the attempt
     3. enqueue_attempt [cost=17, checkpoint=false, retry=true]
        persist the task shell and open attempt 1 in the embedded runtime
     4. capture_input [cost=13, checkpoint=false, retry=false]
        record task goal, priority, and raw input for deterministic resume
     5. durable_checkpoint [cost=14, checkpoint=true, retry=true]
        stop at a resumable checkpoint boundary before asynchronous continuation
(24 rows)

RUN TASK summarize_docs IN SESSION :qx_session_oid
  GOAL 'summarize docs'
  INPUT jsonb_build_object('topic', 'parser')
  PRIORITY high;
SELECT oid AS qx_task_oid
FROM pg_qx_task
ORDER BY oid DESC
LIMIT 1
\gset
SELECT qxtaskname::text AS task_name,
       qxtaskgoal::text AS goal,
       qxtaskpriority::text AS priority,
       qxtaskstate AS state,
       qxtaskinput IS NOT NULL AS has_input,
       qxtasksessionid = :qx_session_oid AS linked_session,
       qxtasklastattemptid <> 0 AS has_attempt,
       qxtasklastcheckpointid <> 0 AS has_checkpoint
FROM pg_qx_task
ORDER BY oid;
   task_name    |      goal      | priority | state | has_input | linked_session | has_attempt | has_checkpoint 
----------------+----------------+----------+-------+-----------+----------------+-------------+----------------
 summarize_docs | summarize docs | high     | k     | t         | t              | t           | t
(1 row)

SELECT qxattemptseqno AS seqno,
       qxattemptstate AS state,
       qxattemptresumecheckpointid = 0 AS starts_fresh,
       qxattemptstrategy::text AS strategy
FROM pg_qx_attempt
ORDER BY qxattemptseqno;
 seqno | state | starts_fresh | strategy 
-------+-------+--------------+----------
     1 | k     | t            | initial
(1 row)

SELECT qxstepseqno AS seqno,
       qxstepname::text AS step_name,
       qxstepstate AS state
FROM pg_qx_step
ORDER BY qxstepseqno;
 seqno |         step_name         | state 
-------+---------------------------+-------
     1 | stage8.scheduler_admit    | c
     2 | stage8.capture_input      | c
     3 | stage8.checkpoint_barrier | c
(3 rows)

SELECT qxeventkind::text AS event_kind,
       qxeventlsn <> '0/0'::pg_lsn AS has_semantic_lsn,
       COALESCE(qxeventlsn > lag(qxeventlsn) OVER (ORDER BY oid), true) AS lsn_monotonic,
       qxeventtaskid = (SELECT oid FROM pg_qx_task ORDER BY oid DESC LIMIT 1) AS linked_task,
       qxeventstepid <> 0 AS has_step
FROM pg_qx_event
ORDER BY oid;
      event_kind       | has_semantic_lsn | lsn_monotonic | linked_task | has_step 
-----------------------+------------------+---------------+-------------+----------
 SESSION_STARTED       | t                | t             | f           | f
 TASK_QUEUED           | t                | t             | t           | f
 TASK_DISPATCHED       | t                | t             | t           | t
 TASK_INPUT_CAPTURED   | t                | t             | t           | t
 TASK_CHECKPOINTED     | t                | t             | t           | t
 TASK_READY_FOR_RESUME | t                | t             | t           | f
(6 rows)

SELECT qxtracename::text AS trace_name,
       qxtracestate AS trace_state,
       qxtracelsn <> '0/0'::pg_lsn AS has_semantic_lsn,
       COALESCE(qxtracelsn > lag(qxtracelsn) OVER (ORDER BY oid), true) AS lsn_monotonic,
       qxtracetaskid = (SELECT oid FROM pg_qx_task ORDER BY oid DESC LIMIT 1) AS linked_task
FROM pg_qx_trace
ORDER BY oid;
      trace_name       | trace_state | has_semantic_lsn | lsn_monotonic | linked_task 
-----------------------+-------------+------------------+---------------+-------------
 session.root          | o           | t                | t             | f
 runtime.queue         | c           | t                | t             | t
 runtime.dispatch      | c           | t                | t             | t
 runtime.capture_input | c           | t                | t             | t
 runtime.checkpoint    | c           | t                | t             | t
 runtime.pause         | c           | t                | t             | t
(6 rows)

SELECT qxcheckpointlabel::text AS checkpoint_label,
       qxcheckpointstate AS checkpoint_state,
       qxcheckpointtaskstate AS task_state,
       qxcheckpointlsn <> '0/0'::pg_lsn AS has_semantic_lsn,
       COALESCE(qxcheckpointlsn > lag(qxcheckpointlsn) OVER (ORDER BY oid), true) AS lsn_monotonic,
       qxcheckpointnextstepseqno AS next_step,
       qxcheckpointattemptid <> 0 AS linked_attempt,
       qxcheckpointtaskid = (SELECT oid FROM pg_qx_task ORDER BY oid DESC LIMIT 1) AS linked_task,
       qxcheckpointdata::text LIKE 'task=%' AS has_data
FROM pg_qx_checkpoint
ORDER BY oid;
   checkpoint_label   | checkpoint_state | task_state | has_semantic_lsn | lsn_monotonic | next_step | linked_attempt | linked_task | has_data 
----------------------+------------------+------------+------------------+---------------+-----------+----------------+-------------+----------
 stage8.after_capture | d                | k          | t                | t             |         4 | t              | t           | t
(1 row)

EXPLAIN AGENT RESUME TASK :qx_task_oid FROM CHECKPOINT 'stage8.after_capture';
                                   AGENT PLAN                                    
---------------------------------------------------------------------------------
 AgentPlan v1
   Command: RESUME TASK
   Checkpoint Label: stage8.after_capture
   Input Present: false
   Target State: completed
   Result Mode: state transition via pg_qx_task
   Checkpointable: true
   Resumable: true
   Estimated Cost: 54
   Estimated Tool Calls: 0
   Steps:
     1. validate_task [cost=7, checkpoint=false, retry=false]
        check task visibility, ownership, and checkpointed state
     2. load_checkpoint [cost=10, checkpoint=true, retry=false]
        load the latest durable checkpoint and verify the requested label
     3. open_resume_attempt [cost=12, checkpoint=false, retry=true]
        create a new runtime attempt linked to the resumable checkpoint
     4. resume_dispatch [cost=14, checkpoint=false, retry=true]
        dispatch the resumed attempt from the stored next-step boundary
     5. final_checkpoint [cost=11, checkpoint=true, retry=false]
        seal completion with a final durable checkpoint and completed task state
(21 rows)

RESUME TASK :qx_task_oid FROM CHECKPOINT 'stage8.after_capture';
