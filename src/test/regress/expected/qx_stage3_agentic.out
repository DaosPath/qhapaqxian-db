 closed      | runtime.external_submit  | phase=submit;tool=search;principal=search_runner;principal_runtime=host;provider=loopback_provider;provider_kind=loopback;effective_sandbox=restricted;profile=restricted;env=minimal;cwd=pg_qx_runtime;process_limit=1;timeout_ms=2000;receipt_schema=qx.receipt.v1;receipt_alg=hmac-sha256;receipt_nonce=submit:search:search_runner;receipt_sig=verified;attestation=loopback_verified;tokens=70;cost=16;detail=tool search via search_runner for submit phase on task <task>;launch_mode=profiled_process;restricted_identity=true;wall_ms=<ms>                   | t        | t
