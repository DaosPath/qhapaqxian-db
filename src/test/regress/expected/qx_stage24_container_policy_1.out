-- Stage 24 container policy regression (no Docker required)
SELECT pg_qx_policy_compile_container(
  'network:deny|privilege_escalation:deny|readonly_rootfs:true|image:alpine:3.20'
) AS default_container_profile;
                                               default_container_profile                                                
------------------------------------------------------------------------------------------------------------------------
 network=deny;privilege_escalation=deny;readonly_rootfs=true;seccomp=no-new-privileges;cgroup=private;image=alpine:3.20
(1 row)

SELECT pg_qx_policy_compile_container(
  'network:allow|privilege_escalation:allow|readonly_rootfs:false|seccomp_mode:unconfined|image:busybox:1.36'
) AS permissive_container_profile;
                                            permissive_container_profile                                             
---------------------------------------------------------------------------------------------------------------------
 network=allow;privilege_escalation=allow;readonly_rootfs=false;seccomp=unconfined;cgroup=private;image=busybox:1.36
(1 row)

SELECT pg_qx_policy_compile_container(
  'network:deny|privilege_escalation:deny|seccomp_mode:no-new-privileges'
) LIKE '%seccomp=no-new-privileges%' AS seccomp_tag_honored;
 seccomp_tag_honored 
---------------------
 t
(1 row)

SELECT pg_qx_policy_compile_container(
  'network:deny|privilege_escalation:deny|cgroup_mode:host|image:alpine:3.20'
) LIKE '%cgroup=host%' AS cgroup_tag_honored;
 cgroup_tag_honored 
--------------------
 t
(1 row)

SELECT pg_qx_policy_compile_container(
  'network:deny|privilege_escalation:deny|seccomp_mode:strict|cgroup_mode:isolated|image:alpine:3.20'
) LIKE '%seccomp=strict%cgroup=isolated%' AS hardened_policy_profile;
 hardened_policy_profile 
-------------------------
 t
(1 row)

SELECT pg_qx_policy_validate_image('alpine:3.20');
