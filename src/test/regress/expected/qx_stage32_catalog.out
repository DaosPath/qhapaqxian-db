FROM pg_qx_trace
WHERE qxtracename = 'session.root'
  AND qxtracesessionid = (
    SELECT oid FROM pg_qx_session
    WHERE qxsessionagentid = (SELECT oid FROM pg_qx_agent WHERE qxagentname = 'catalog_probe')
    ORDER BY oid DESC
    LIMIT 1
