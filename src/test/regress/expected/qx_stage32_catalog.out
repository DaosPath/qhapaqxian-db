-- Stage 32 catalog helper layer regression (loopback, self-contained)
CREATE PROVIDER public.catalog_loopback_provider
  KIND 'loopback'
  ENDPOINT 'local://qhapaqxian-tool-runner'
  RECEIPT KEY 'catalog-loopback-key'
  ATTESTATION PROFILE 'loopback.local'
  VERSION 'v1'
  POLICY loopback_attest
  ATTESTATION ENABLE;
CREATE PRINCIPAL public.catalog_search_runner
  PROGRAM 'qhapaqxian-tool-runner'
  SANDBOX 'restricted'
  RUNTIME 'host'
  PROVIDER public.catalog_loopback_provider
  ATTESTATION PROFILE 'loopback.local'
  VERSION 'v1'
  POLICY loopback_attest;
CREATE TOOL public.catalog_search
  HANDLER 'builtin.search'
  SANDBOX 'builtin'
  PRINCIPAL 'catalog_search_runner'
  TOKEN COST 5
  COST 3;
CREATE NAMESPACE POLICY catalog_only FOR SCHEMA public
  TOOLS (catalog_search)
  KNOWN TOOLS ENABLE
  BUDGET ENABLE;
CREATE AGENT catalog_probe
  IDENTITY catalog_probe_identity
  TOOLS (catalog_search)
  POLICY catalog_only
  BUDGET (tokens 2048, cost 64);
START SESSION FOR AGENT catalog_probe
  WITH CONTEXT jsonb_build_object('mission', 'catalog');
SELECT count(*) = 1 AS provider_row_present
FROM pg_qx_provider
WHERE qxprovidername = 'catalog_loopback_provider';
 provider_row_present 
----------------------
